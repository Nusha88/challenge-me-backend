# Copy to .env and fill in. The app reads these via dotenv at startup.

# ---- Required (server exits at boot without these) ----

# MongoDB Atlas / MongoDB connection string.
ATLAS_URI=mongodb://127.0.0.1:27017/ignite

# Secret used to sign/verify JWTs. Use a long random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Optional (features degrade gracefully if unset) ----

# Transactional email (Resend). If unset, emails are disabled (warn + no-op).
RESEND_API_KEY=
FROM_EMAIL=Ignite <noreply@ignite-me.app>
REGISTRATION_NOTIFY_EMAIL=
EMAIL_LOGO_URL=

# ImgBB key for the server-side image upload proxy (POST /api/uploads/image).
# Kept server-side so it never ships in the client bundle. If unset, the
# endpoint returns 503 and image uploads are disabled.
IMGBB_API_KEY=

# Web push (VAPID). If unset, push notifications are disabled (warn only).
# Generate keys: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Frontend origin used when building email links.
FRONTEND_URL=http://localhost:5173

# Server
PORT=3000
NODE_ENV=development

# Extra allowed CORS origins (comma-separated). Defaults include ignite-me.app
# plus localhost origins outside production.
CORS_ALLOWED_ORIGINS=

# ---- Rate limiting (optional overrides) ----
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=3
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---- Scheduler send-time overrides (optional) ----
WEEKLY_CHRONICLE_SEND_TIME=
WEEKLY_CHRONICLE_SEND_WEEKDAY=
REACTIVATION_EMAIL_ENABLED=
REACTIVATION_EMAIL_SEND_TIME=
